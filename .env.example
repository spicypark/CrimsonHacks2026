# Copy to .env.local and fill in. See README.md for where to get each value.

# AI: every AI feature (extraction, tags, summaries, dedupe, search, Plan my night) uses Claude Haiku 5.5
ANTHROPIC_API_KEY=

# Event sources
TICKETMASTER_API_KEY=
SEATGEEK_CLIENT_ID=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=

# App
ADMIN_SECRET=change-me
# Public URL, used in the Nominatim/Reddit User-Agent and share links
APP_URL=http://localhost:3000
# Local default is ./data/pullup.db; on Railway set to /data/pullup.db (volume)
DATABASE_PATH=
