# Copy to .env.local and fill in. See SETUP.md for where to get each value.

# AI
GEMINI_API_KEY=
# Comma-separated fallback chain (a model returning 503 "high demand" falls through to the next)
GEMINI_MODEL=gemini-3.5-flash,gemini-3.6-flash,gemini-3.5-flash-lite
# Models for search (a person is waiting): fastest first
GEMINI_FAST_MODEL=gemini-3.5-flash-lite,gemini-3.5-flash
GEMINI_EMBED_MODEL=gemini-embedding-001
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Event sources
TICKETMASTER_API_KEY=
SEATGEEK_CLIENT_ID=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=

# App
ADMIN_SECRET=change-me
# Public URL, used in the Nominatim/Reddit User-Agent and share links
APP_URL=http://localhost:3000
# Local default is ./data/pullup.db; on Railway set to /data/pullup.db (volume)
DATABASE_PATH=
