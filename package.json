{
  "name": "pullup",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n web,worker -c cyan,magenta \"next dev\" \"npm:worker\"",
    "dev:web": "next dev",
    "build": "next build",
    "start": "concurrently -k -n web,worker \"next start\" \"npm:worker\"",
    "worker": "tsx --env-file-if-exists=.env.local src/pipeline/worker.ts",
    "pipeline": "tsx --env-file-if-exists=.env.local src/pipeline/worker.ts --once",
    "seed": "tsx --env-file-if-exists=.env.local scripts/seed-sources.ts",
    "db:generate": "drizzle-kit generate",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "seed:demo": "tsx --env-file-if-exists=.env.local scripts/seed-demo.ts"
  },
  "dependencies": {
    "@date-fns/tz": "^1.5.0",
    "@google/genai": "^3.0.0",
    "better-sqlite3": "^13.0.3",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.2",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.4",
    "groq-sdk": "^1.6.0",
    "lucide-react": "^1.70.0",
    "maplibre-gl": "^6.16.0",
    "nanoid": "^6.0.2",
    "next": "16.4.5",
    "node-ical": "^0.27.4",
    "p-limit": "^7.3.3",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shadcn": "^4.23.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7",
    "tsx": "^4.23.15",
    "concurrently": "^10.0.6"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=22.9"
  }
}
